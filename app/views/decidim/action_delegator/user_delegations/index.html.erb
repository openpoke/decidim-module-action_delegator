<%= render layout: "layouts/decidim/shared/layout_user_profile" do %>
  <div class="row column voluntary-work-list">
    <% active_pairs = delegations.flat_map { |d| d.setting.elections.published.ongoing.map { |e| [e, d] } } %>
    <% if active_pairs.any? %>
      <div class="card__list-list">
        <% active_pairs.each do |election, delegation| %>
          <div class="card__list">
            <div class="card__list-content">
              <h5 class="card__list-title">
                <%= link_to translated_attribute(election.title),
                            Decidim::EngineRouter.main_proxy(election.component).election_path(election) %>
              </h5>
              <div class="card__list-text">
                <%= t("vote_delegated_html", scope: "decidim.action_delegator.user_delegations.index", name: delegation.granter.name) %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="callout secondary">
        <%= t("no_active_delegations", scope: "decidim.action_delegator.user_delegations.index") %>
      </div>
    <% end %>
  </div>
<% end %>
